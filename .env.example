# === Local Development ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=portfolio_db
DB_SSLMODE=disable

# === Production (pilih salah satu: DATABASE_URL atau DB_* di atas) ===
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# === App Config ===
JWT_SECRET=ganti-ke-secret-yang-kuat
PORT=8080

# === CORS — origin tambahan selain Vercel (comma-separated) ===
# ALLOWED_ORIGINS=http://localhost:3000,https://custom-domain.com